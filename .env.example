# 复制为 .env 即可跑通全链路——默认无需任何外部凭证（约束 C3）。
# 完整说明见 docs/11-dev-setup.md §3。

# ── 核心 ──
DATABASE_URL=postgresql://drama:drama@localhost:5432/drama
REDIS_URL=redis://localhost:6379
CONTROL_PORT=4000
NEXT_PUBLIC_API_BASE=http://localhost:4000
# 面板的写操作要带它，值必须与下面的 CONTROL_API_KEY 一致。
# NEXT_PUBLIC_ 前缀是硬要求：Next 只把这个前缀的变量编译进浏览器包。
NEXT_PUBLIC_CONTROL_API_KEY=devlocal

# ── 写路径闸门（重要）──
# 所有非 GET 请求必须带 `x-api-key: <此值>`，否则 401。控制面**未设它就起不来**。
#
# 防的是这条实测走通过的路径：任意网页发一个无 body、无 Content-Type 的
# POST /api/episodes/:id/generate-batch 就能规划整集并真的花钱——那是 CORS
# 简单请求，浏览器直接发，收紧 origin 也拦不住。要求一个自定义头会强制预检，
# 恶意来源的预检过不了，真实请求根本发不出去。
#
# 本地随便填一个值即可；它会进浏览器包，不是能对本机用户保密的秘密。
CONTROL_API_KEY=devlocal
# CONTROL_HOST=0.0.0.0    # 默认只听 127.0.0.1。要从手机/别的机器访问才打开，
#                         # 那时 CONTROL_API_KEY 的值才真正承担秘密职责
# WEB_ORIGIN=http://localhost:3000   # 收紧 CORS：不设则反射任意来源，
#                                    # 恶意页面能跨域读 GET、先枚举 UUID 再开火

# 宿主端口。scripts/dev.sh 用 `docker compose --env-file .env` 把这几个值传给
# compose，所以容器发布的端口与上面 URL 里的端口出自同一份文件。
# **改端口要两处一起改**——开发机上常已有原生 Postgres 占着 5432，那就把
# POSTGRES_PORT 与 DATABASE_URL 一起改成 5433。
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MEDIA_WORKER_PORT=8002

# ── 存储 ──
# 两个 endpoint 必须分开：远程 GPU 场景下签给 worker 的 URL 里不能是 localhost，
# 否则 worker 上传必然失败（09-python-worker.md §5.1，最常见的集成坑）。
S3_BUCKET=drama
S3_ACCESS_KEY=adminlocal
S3_SECRET_KEY=adminlocal123
S3_INTERNAL_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ── Worker 寻址（端口见 09-python-worker.md §2）──
MEDIA_WORKER_URL=http://localhost:8002
# EVAL_WORKER_URL=http://localhost:8003        # 自动评测，M6 启用

# ── Provider ──
# 所有 API key 只在这份根 .env 里管理，子包一律不放 .env：
#   apps/control → node --env-file-if-exists=../../.env
#   apps/web     → 同上（Next 默认只读自己目录，不加这个参数读不到根 .env）
#   vitest       → vitest.config.ts 的 loadEnvFile
#   workers/*    → 由 infra/docker-compose.yml 注入
#
# 注意 vitest.config.ts 默认会摘掉所有 *_API_KEY——`pnpm test` 不该有能力花钱。
# 录制契约测试卡带时用 RECORD=1 放行，那是唯一应该真花钱的场景。
DEFAULT_PROVIDER=mock
MOCK_FAILURE_RATE=0.15                          # 让重试逻辑在开发期就被触发
MOCK_SEED_DETERMINISTIC=0                       # 置 1：同 seed 返回同一条 fixture，快照测试用
# 云 provider 统一走 OpenRouter（一把 key、一个 host、原生回报 usage.cost）。
# 不直连任何厂商 SDK。M1 落地时才取消注释——没有实现的配置项等于假装已支持。
# 云 provider：填了 key 才进池，没填则池里只有 mock（约束 C3 照旧成立）。
# 每个 model 一个池条目，id 形如 openrouter:google/veo-3.1-lite——成本按 model 归因。
# 能力与价目表是代码里的快照（providers/openrouterModels.ts），RECORD=1 时校验漂移。
#
# ⚠️ 第一次填进来之后，先跑 `node scripts/probe-openrouter.mjs`（约 $0.12），
#    它回答几个只能实测的问题——尤其是产物 URL 需不需要鉴权。**跑整集之前先跑它。**
# OPENROUTER_API_KEY=
# OPENROUTER_VIDEO_MODELS=google/veo-3.1-lite,alibaba/wan-2.7
# OPENROUTER_REFERER=                                      # 可选，OpenRouter 排行榜归因
# OPENROUTER_TITLE=                                        # 可选，同上
# SELFHOST_VIDEO_URL=http://100.x.y.z:8001                 # M2
# SELFHOST_MODEL=wan2.2-ti2v-5b

# ── LLM（剧本/分镜）──
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ── TTS ──
TTS_PROVIDER=mock
# ELEVENLABS_API_KEY=

# ── 预算闸门（重要）──
# 防一次误操作把整批任务打到云 API 上（05-job-orchestration.md §6）
BUDGET_DAILY_MICRO_USD=5000000                  # $5/天
BUDGET_ON_EXCEED=block

# ── 并发 ──
MAX_GLOBAL_CONCURRENT=32
