{
  "name": "@ai-drama/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec next dev -p 3000'",
    "build": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec next build'",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-drama/contracts": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-virtual": "^3.14.9",
