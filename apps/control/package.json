{
  "name": "@ai-drama/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env dist/db/migrate.js",
    "db:seed": "node --env-file=../../.env dist/db/seed.js",
    "db:reset": "node --env-file=../../.env dist/db/reset.js"
  },
  "dependencies": {
    "@ai-drama/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3"
  }
}
