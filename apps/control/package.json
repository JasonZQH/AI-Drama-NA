{
  "name": "@ai-drama/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/db/seed.js",
    "db:reset": "node --env-file-if-exists=../../.env dist/db/reset.js",
    "dev:worker": "node --watch --env-file-if-exists=../../.env dist/worker.js",
    "dev": "node --watch --env-file-if-exists=../../.env dist/server.js & node --watch --env-file-if-exists=../../.env dist/worker.js & wait"
  },
  "dependencies": {
    "@ai-drama/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@fastify/cors": "^11.3.0",
    "bullmq": "^6.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3"
  }
}
